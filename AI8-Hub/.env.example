PORT=7865

# Optional local API protection for your own adapter.
# If set, callers must send Bearer <key> or x-api-key.
API_KEYS=
ADMIN_TOKEN=

AI8_BASE_URL=https://ai8.rcouyi.com/api
AI8_AUTH_TOKEN=
AI8_X_APP_VERSION=3.0.1
AI8_DEFAULT_MODEL=openai_chat::gpt-4.1-mini
AI8_IMAGE_MODELS=gpt-image-1,gpt-image-2,dall-e-3
AI8_DEFAULT_THINKING=false
AI8_REQUEST_TIMEOUT_MS=300000
AI8_MIN_OUTPUT_TOKENS=8192
AI8_SHARED_SESSION_ID=
AI8_ALLOWED_MODELS=
AI8_BLACKLISTED_MODELS=
MEDIA_FETCH_TIMEOUT_MS=60000
REQUEST_BODY_LIMIT=50mb
PUBLIC_BASE_URL=
AI8_CONFIG_PATH=./data/config.json
AI8_LOG_PATH=./logs/ai8-adapter.log

# gpt-all independent channel (model ids get the 【gpt-all】 suffix)
GPTALL_ENABLED=false
GPTALL_BASE_URL=https://gpt-all.chat/api
GPTALL_AUTH_TOKEN=
GPTALL_COOKIE=
GPTALL_FINGERPRINT=89346554
GPTALL_DEFAULT_MODEL=doubao-seed-2.0-lite
GPTALL_ALLOWED_MODELS=
GPTALL_BLACKLISTED_MODELS=
GPTALL_REQUEST_TIMEOUT_MS=300000
